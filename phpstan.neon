includes:
    - vendor/larastan/larastan/extension.neon
    # Pre-existing type-annotation debt, captured the first time PHPStan was
    # actually able to run here: before the root require-dev listed every
    # package dependency it died outright on a missing trait and analysed
    # nothing. The baseline exists so CI fails on NEW errors instead of
    # drowning in 157 old ones; it is a debt ledger to shrink, not a licence.
    - phpstan-baseline.neon

parameters:
    level: 7

    paths:
        - packages/ai-core/src
        - packages/ai-core-filament/src
        - packages/ai-posts/src
        - packages/ai-chat/src
        - packages/ai-products/src
        - packages/ai-webinars/src

    excludePaths:
        analyseAndScan:
            - packages/*/vendor
